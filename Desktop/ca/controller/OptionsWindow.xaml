<Window x:Class="Controller.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synapse X Options" Height="380" Width="460"
        Background="{StaticResource BgDarkest}" Foreground="#E0E0E0"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" MouseDown="Window_MouseDown">
            <Grid>
                <Border VerticalAlignment="Top" Height="2" Background="{DynamicResource AccentOrange}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,2,0,0">
                    <TextBlock Text="⚙" Foreground="{DynamicResource AccentOrange}" FontSize="14" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="OPTIONS" Foreground="#E0E0E0" FontSize="13"
                               FontWeight="Bold" FontFamily="Segoe UI Semibold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✕" Style="{StaticResource DangerChromeButtonStyle}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- ============ CONTENT ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgDarkest}">
            <StackPanel Margin="16,8">

                <!-- ── Theme Section ── -->
                <TextBlock Text="APPEARANCE" Foreground="#555555" FontSize="9"
                           FontWeight="Bold" Margin="0,4,0,6"/>

                <Border Background="{StaticResource PanelBg}" CornerRadius="3" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Theme" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="ThemeSelector"
                                  Background="{StaticResource TabBg}" Foreground="#CCCCCC"
                                  BorderBrush="#333333" BorderThickness="1"
                                  Height="28" FontSize="12"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="Synapse Orange"/>
                            <ComboBoxItem Content="Synapse Cyan"/>
                            <ComboBoxItem Content="Synapse Lime"/>
                            <ComboBoxItem Content="Synapse Red"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- ── Performance Section ── -->
                <TextBlock Text="PERFORMANCE" Foreground="#555555" FontSize="9"
                           FontWeight="Bold" Margin="0,4,0,6"/>

                <Border Background="{StaticResource PanelBg}" CornerRadius="3" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox Content="Unlock FPS (removes 60fps cap)"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="FPSUnlock"/>
                        <CheckBox Content="Reduce memory usage"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="LowMemoryMode"/>
                        <CheckBox Content="Disable rendering when unfocused"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="UnfocusedRender"/>
                    </StackPanel>
                </Border>

                <!-- ── Automation Section ── -->
                <TextBlock Text="AUTOMATION" Foreground="#555555" FontSize="9"
                           FontWeight="Bold" Margin="0,8,0,6"/>

                <Border Background="{StaticResource PanelBg}" CornerRadius="3" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox Content="Auto Launch (inject on game start)"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="AutoLaunch"/>
                        <CheckBox Content="Auto execute saved scripts on injection"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="AutoExecute"/>
                        <CheckBox Content="Auto-attach to Roblox process"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="AutoAttach"/>
                    </StackPanel>
                </Border>

                <!-- ── Interface Section ── -->
                <TextBlock Text="INTERFACE" Foreground="#555555" FontSize="9"
                           FontWeight="Bold" Margin="0,8,0,6"/>

                <Border Background="{StaticResource PanelBg}" CornerRadius="3" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox Content="Internal UI mode"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="InternalUI"/>
                        <CheckBox Content="Discord Rich Presence"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="DiscordRPC"/>
                        <CheckBox Content="Silent Aim (hide visual indicators)"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="SilentAbs"/>
                        <CheckBox Content="Minimize to system tray"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="SystemTray"/>
                    </StackPanel>
                </Border>

                <!-- ── Security Section ── -->
                <TextBlock Text="SECURITY" Foreground="#555555" FontSize="9"
                           FontWeight="Bold" Margin="0,8,0,6"/>

                <Border Background="#141414" CornerRadius="3" Padding="12,8" Margin="0,0,0,4">
                    <StackPanel>
                        <CheckBox Content="Pipe name randomization"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="PipeRandom"/>
                        <CheckBox Content="Integrity spoofing"
                                  Style="{StaticResource ModernCheckboxStyle}" x:Name="IntegritySpoof"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ FOOTER ============ -->
        <Border Grid.Row="2" Background="{StaticResource BgDark}" BorderBrush="#1E1E1E" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="12,0">
                <Button Content="APPLY" Width="80" Height="26" Margin="0,0,6,0"
                        Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"/>
                <Button Content="CLOSE" Width="80" Height="26"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
