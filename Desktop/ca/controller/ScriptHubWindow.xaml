<Window x:Class="Controller.ScriptHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synapse X Script Hub" Height="560" Width="940"
        Background="{StaticResource BgDarkest}" Foreground="#E0E0E0"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown"
        ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                       GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" MouseDown="Window_MouseDown">
            <Grid>
                <Border VerticalAlignment="Top" Height="2" Background="{DynamicResource AccentOrange}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentOrange}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SCRIPT HUB" Foreground="#E0E0E0" FontSize="13"
                               FontWeight="Bold" FontFamily="Segoe UI Semibold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="v4.2.3" Foreground="#555555" FontSize="10"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultCount" Text="16 scripts loaded"
                               Foreground="#666666" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="—" Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource DangerChromeButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ BODY ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- == LEFT SIDEBAR: Categories == -->
            <Border Grid.Column="0" Background="{StaticResource BgDark}" BorderBrush="#1E1E1E" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgDarkest}" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="SYNAPSE" Foreground="{DynamicResource AccentOrange}" FontSize="14"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="Script Repository" Foreground="#555555" FontSize="9"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                        <StackPanel x:Name="CategoryPanel">
                            <Button Content="★  All Scripts" Style="{StaticResource CategoryButtonStyle}"
                                    Tag="Selected" Click="Category_Click" x:Name="CatAll"/>
                            <Button Content="★  Favorites" Style="{StaticResource CategoryButtonStyle}"
                                    Click="Category_Click" Foreground="{StaticResource AccentOrange}"/>
                            <TextBlock Text="TYPES" Foreground="#444444" FontSize="9" FontWeight="Bold"
                                       Margin="14,8,0,2"/>
                            <Button Content="⚔  Admin" Style="{StaticResource CategoryButtonStyle}"
                                    Click="Category_Click"/>
                            <Button Content="🔧  Utility" Style="{StaticResource CategoryButtonStyle}"
                                    Click="Category_Click"/>
                            <Button Content="🎯  Combat" Style="{StaticResource CategoryButtonStyle}"
                                    Click="Category_Click"/>
                            <Button Content="👻  Visual / ESP" Style="{StaticResource CategoryButtonStyle}"
                                    Click="Category_Click"/>
                            <Button Content="🏰  Hubs" Style="{StaticResource CategoryButtonStyle}"
                                    Click="Category_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- == RIGHT PANEL: Search + Custom URL + Cards + Info Panel == -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2" Margin="155,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <Border Grid.Row="0" Background="{StaticResource BgDark}" Padding="12,10"
                        BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Tag>
                                <TextBlock Text="🔍  Search scripts..." Foreground="#555555"
                                           IsHitTestVisible="False"/>
                            </TextBox.Tag>
                        </TextBox>
                        <Button Grid.Column="1" Content="🔄  Refresh" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click"/>
                    </Grid>
                </Border>

                <!-- Custom URL input -->
                <Border Grid.Row="1" Background="{StaticResource BgDark}" Padding="12,8"
                        BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomUrlBox" Grid.Column="0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Margin="0,0,8,0">
                            <TextBox.Tag>
                                <TextBlock Text="Paste script URL here..." Foreground="#555555"
                                           IsHitTestVisible="False"/>
                            </TextBox.Tag>
                        </TextBox>
                        <Button Grid.Column="1" Content="LOAD" Height="32" Width="60"
                                Style="{StaticResource AccentButtonStyle}" Click="LoadCustomUrl_Click"/>
                    </Grid>
                </Border>

                <!-- Cards + Info Panel -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Script cards -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource BgDarkest}" Padding="8,6">
                        <WrapPanel x:Name="ScriptContainer"/>
                    </ScrollViewer>

                    <!-- Info Panel -->
                    <Border Grid.Column="1" x:Name="InfoPanel" Visibility="Collapsed"
                            Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderDark}"
                            BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,10">
                                <Border x:Name="InfoAccentBar" Height="3" Margin="0,0,0,10"
                                        CornerRadius="2"/>
                                <TextBlock x:Name="InfoName" FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InfoAuthor" FontSize="11"
                                           Foreground="{StaticResource AccentOrange}" Margin="0,0,0,8"/>
                                <Border x:Name="InfoCategoryBadge"
                                        Background="{StaticResource BgMedium}"
                                        CornerRadius="2" Padding="6,2"
                                        HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock x:Name="InfoCategoryText" FontSize="8"
                                               FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="InfoDescription" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="URL:" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="InfoUrl" IsReadOnly="True"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         FontSize="10" Margin="0,0,0,10"
                                         TextWrapping="Wrap" MinHeight="28"/>
                                <CheckBox x:Name="InfoFavoriteToggle" Content="ADD TO FAVORITES"
                                          Style="{StaticResource ModernCheckboxStyle}"
                                          Checked="InfoFavorite_Changed" Unchecked="InfoFavorite_Changed"
                                          Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <CheckBox x:Name="InfoAutoExecToggle" Content="ADD TO AUTO-EXECUTE"
                                          Style="{StaticResource ModernCheckboxStyle}"
                                          Checked="InfoAutoExec_Changed" Unchecked="InfoAutoExec_Changed"
                                          Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <Button x:Name="InfoExecuteButton" Content="▶  EXECUTE"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="34" Margin="0,10,0,0"
                                        Click="InfoExecute_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ FOOTER ============ -->
        <Border Grid.Row="2" Background="{StaticResource BgDark}" BorderBrush="#1E1E1E" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Ellipse Width="6" Height="6" Fill="#76FF03" Margin="0,0,6,0"/>
                    <TextBlock x:Name="FooterStatus" Text="Ready — Select a script to execute"
                               Foreground="#666666" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                    <Button Content="RUN AUTO-EXECUTE" Width="130" Height="24" Margin="0,0,4,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="RunAutoExecute_Click"
                            x:Name="RunAutoExecuteButton"/>
                    <Button Content="CLOSE" Width="70" Height="24" Margin="0,0,4,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
                    <Button Content="EXECUTE SELECTED" Width="130" Height="24"
                            Style="{StaticResource AccentButtonStyle}" Click="ExecuteSelected_Click"
                            x:Name="ExecuteSelectedButton" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
