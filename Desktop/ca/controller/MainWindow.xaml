<Window x:Class="Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Synapse X | Security Research Interface" Height="640" Width="900"
        Background="{StaticResource BgDarkest}" Foreground="{StaticResource TextPrimary}"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        MouseDown="Window_MouseDown" PreviewKeyDown="Window_KeyDown"
        ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                       GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" MouseDown="Window_MouseDown">
            <Grid>
                <!-- Orange accent line -->
                <Border VerticalAlignment="Top" Height="2" Background="{DynamicResource AccentOrange}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,2,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#555555" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SYNAPSE X" Foreground="#E0E0E0" FontSize="13"
                               FontWeight="Bold" FontFamily="Segoe UI Semibold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="#444444" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Security Research Interface" Foreground="#888888" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BgMedium}" CornerRadius="2" Padding="6,1"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v4.3.0" Foreground="{DynamicResource AccentOrange}" FontSize="9" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="TopmostToggle" Content="📌" Width="35"
                                  Style="{StaticResource ChromeToggleStyle}"
                                  Click="Topmost_Click"
                                  ToolTip="Always on Top" IsChecked="True"/>
                    <Button Content="—" Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource DangerChromeButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ BODY ============ -->
        <Grid Grid.Row="1" Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="185"/>
            </Grid.ColumnDefinitions>

            <!-- == Editor pane == -->
            <Grid Grid.Column="0" Margin="0,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab bar -->
                <DockPanel Grid.Row="0" Background="{StaticResource TabBg}" LastChildFill="False">
                    <TabControl x:Name="ScriptTabs" Background="Transparent" BorderThickness="0"
                                Height="28" SelectionChanged="ScriptTabs_SelectionChanged"
                                DockPanel.Dock="Left">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource ScriptTabStyle}"/>
                        </TabControl.Resources>
                        <TabItem Header="Script 1"/>
                    </TabControl>
                    <Button Content="+" Width="26" Height="24" Background="Transparent"
                            Foreground="#666666" BorderThickness="0" FontSize="16"
                            Click="AddTab_Click" ToolTip="New Tab" DockPanel.Dock="Left"
                            Cursor="Hand" Margin="2,0"/>
                    <Button Content="◀" Width="22" Height="24" Background="Transparent"
                            Foreground="#666666" BorderThickness="0" FontSize="12"
                            Click="MoveTabLeft_Click" ToolTip="Move Tab Left" DockPanel.Dock="Left"
                            Cursor="Hand" Margin="2,0"/>
                    <Button Content="▶" Width="22" Height="24" Background="Transparent"
                            Foreground="#666666" BorderThickness="0" FontSize="12"
                            Click="MoveTabRight_Click" ToolTip="Move Tab Right" DockPanel.Dock="Left"
                            Cursor="Hand" Margin="2,0"/>
                </DockPanel>

                <!-- AvalonEdit editor -->
                <Border Grid.Row="1" BorderThickness="1" CornerRadius="0,0,2,2"
                        BorderBrush="#333333">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.15" Color="Black" ShadowDepth="2"/>
                    </Border.Effect>
                    <avalonEdit:TextEditor Name="Editor"
                                           Background="{StaticResource BgDark}"
                                           Foreground="#D4D4D4"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           ShowLineNumbers="True"
                                           LineNumbersForeground="#444444"
                                           WordWrap="False"/>
                </Border>
            </Grid>

            <!-- == Script explorer pane == -->
            <Grid Grid.Column="1" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <!-- Explorer header -->
                <Border Grid.Row="0" Background="{StaticResource TabBg}" BorderBrush="#333333" BorderThickness="1,1,1,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="📁" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Explorer" Foreground="#888888" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- File list -->
                <ListBox x:Name="ScriptList" Grid.Row="1"
                         Background="{StaticResource PanelBg}" Foreground="#CCCCCC"
                         BorderThickness="1,0,1,1" BorderBrush="#333333"
                         MouseDoubleClick="ScriptList_DoubleClick"
                         ItemContainerStyle="{StaticResource DarkListBoxItem}"/>

                <!-- Refresh button -->
                <Button Grid.Row="2" Content="🔄  Refresh List"
                        Background="{StaticResource BgLight}" Foreground="#999999"
                        BorderThickness="1" BorderBrush="#333333"
                        Click="Refresh_Click" Cursor="Hand" FontSize="11"
                        Margin="0,2,0,0"/>
            </Grid>
        </Grid>

        <!-- ============ BOTTOM PANEL (TABS) ============ -->
        <Border Grid.Row="2" Background="{StaticResource TerminalBg}" Margin="6,3">
            <Border BorderThickness="1" CornerRadius="2" BorderBrush="#1E1E1E">
                <TabControl x:Name="BottomTabs" Background="Transparent" BorderThickness="0"
                            TabStripPlacement="Top">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#1E1E1E"/>
                            <Setter Property="Foreground" Value="#888888"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="18,4"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0,2,0,0"
                                                BorderBrush="Transparent">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#141414"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TerminalDim}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TerminalDim}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TERMINAL TAB -->
                    <TabItem Header="  TERMINAL  ">
                    <TextBox x:Name="TerminalOutput"
                             Background="Transparent" Foreground="{DynamicResource TerminalGreen}"
                                 IsReadOnly="True" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="4,4,4,4"
                                 Text="[SYSTEM] Pipe listener ready...&#x0a;[SYSTEM] Awaiting DLL injection...&#x0a;[SYSTEM] Synapse X v4.3.0 initialized"/>
                    </TabItem>

                    <!-- TELEMETRY TAB -->
                    <TabItem Header="  TELEMETRY  ">
                        <ListView x:Name="TelemetryListView"
                                  Background="{StaticResource BgDarkest}"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderThickness="0"
                                  FontFamily="Consolas" FontSize="11">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewColumnHeader">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Time" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Time}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           Margin="6,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Status" Width="55">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="OK">
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Identity" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Identity}"
                                                           Foreground="{StaticResource AccentOrange}"
                                                           Margin="6,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Source" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Source}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="6,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <!-- AI ASSISTANT TAB -->
                    <TabItem Header="  AI  ">
                        <Grid Background="#050505">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Settings bar -->
                            <Border Grid.Row="0" Background="#0F0F0F"
                                    BorderBrush="#1A1A1A" BorderThickness="0,0,0,1"
                                    Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="API:" Foreground="#444444" FontSize="9"
                                               VerticalAlignment="Center" Margin="2,0,4,0" FontFamily="Consolas"/>
                                    <PasswordBox x:Name="AiApiKeyBox" Width="220" Height="20"
                                                 Background="#0A0A0A" Foreground="#00CC00"
                                                 BorderBrush="#1A1A1A" BorderThickness="1"
                                                 FontFamily="Consolas" FontSize="9"
                                                 PasswordChanged="AiApiKey_Changed"/>
                                    <TextBlock Text="MODEL:" Foreground="#444444" FontSize="9"
                                               FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                     <TextBox x:Name="AiModelBox" Width="120" Height="20"
                                              Background="#0A0A0A" Foreground="#FF8C00"
                                             BorderBrush="#1A1A1A" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="9"
                                             Text="deepseek-chat"
                                             TextChanged="AiSettings_Changed"/>
                                    <Button x:Name="AiResetBtn" Content="CLEAR" Width="50" Height="20"
                                            Margin="8,0,0,0" FontSize="9"
                                            Background="#1A1A1A" Foreground="#666666"
                                            BorderThickness="0" Cursor="Hand"
                                            Click="AiReset_Click"/>
                                    <TextBlock x:Name="AiStatusText" Text="READY"
                                               Foreground="#00AA00"
                                               FontSize="9" FontFamily="Consolas"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Chat display -->
                            <ScrollViewer x:Name="AiChatScroller" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="#050505" Padding="6,4">
                                <StackPanel x:Name="AiChatPanel"/>
                            </ScrollViewer>

                            <!-- Input bar -->
                            <Border Grid.Row="2" Background="#0F0F0F"
                                    BorderBrush="#1A1A1A" BorderThickness="0,1,0,0"
                                    Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                     <TextBox x:Name="AiInputBox" Grid.Column="0" Height="30"
                                              Background="#0A0A0A" Foreground="#00FF00"
                                              CaretBrush="#00FF00"
                                             BorderBrush="#1A1A1A" BorderThickness="1"
                                             FontFamily="Consolas" FontSize="11"
                                             VerticalContentAlignment="Center" Padding="6,0"
                                             KeyDown="AiInput_KeyDown">
                                        <TextBox.Tag>
                                            <TextBlock Text="> Ask about code, offsets, evasion..." Foreground="#333333"
                                                       IsHitTestVisible="False" FontFamily="Consolas" FontSize="11"/>
                                        </TextBox.Tag>
                                    </TextBox>
                                    <Button x:Name="AiSendBtn" Grid.Column="1" Content="SEND"
                                            Width="55" Height="30" Margin="6,0,0,0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="AiSend_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Border>

        <!-- ============ FOOTER BUTTONS ============ -->
        <Border Grid.Row="3" Background="{StaticResource FooterBg}" Margin="6,0,6,6" CornerRadius="2">
            <Border.BorderBrush>
                <SolidColorBrush Color="#FF8C00" Opacity="0.3"/>
            </Border.BorderBrush>
            <Border BorderThickness="0,1,0,0" BorderBrush="#FF8C00" CornerRadius="2"
                    Background="{StaticResource FooterBg}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="6,0" HorizontalAlignment="Left">
                        <Button Content="▶  EXECUTE" Width="95" Height="28" Margin="2,0"
                                Style="{StaticResource AccentButtonStyle}" Click="Execute_Click"/>
                        <Button Content="🗑  CLEAR" Width="85" Height="28" Margin="2,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Clear_Click"/>
                        <Button Content="📂  OPEN" Width="80" Height="28" Margin="2,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Open_Click"/>
                        <Button Content="💾  SAVE" Width="80" Height="28" Margin="2,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Save_Click"/>

                        <Border Width="1" Background="#333333" Margin="8,4"/>

                        <Button Content="⚙  OPTIONS" Width="90" Height="28" Margin="2,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Options_Click"/>
                        <Button Content="📜  SCRIPT HUB" Width="110" Height="28" Margin="2,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ScriptHub_Click"/>
                        <Button x:Name="LaunchButton" Content="LAUNCH" Width="90" Height="28" Margin="2,0"
                                Style="{StaticResource AccentButtonStyle}" Click="Launch_Click"/>
                        <Button Content="🔗  ATTACH" Width="90" Height="28" Margin="2,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Inject_Click"/>
                    </StackPanel>
                    <Button Content="🎨" Width="35" Height="28" HorizontalAlignment="Right"
                            Margin="0,0,8,0" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ThemeCycle_Click" ToolTip="Cycle theme (Ctrl+T)"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
